# Copy to .env and fill in. Used for local dev and as a reference for the
# Render preview env vars. See PREVIEW.md.

# --- Required ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/milestones
PORT=8080

# --- Frontend (Vite) ---
BASE_PATH=/

# --- Auth: pick ONE approach ---
# A) Real Clerk (free dev instance). Get keys at https://dashboard.clerk.com
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
INITIAL_ADMIN_EMAIL=you@example.com

# B) Dev-auth bypass (no Clerk account). Set these and leave Clerk keys blank.
#    NOTE: the bypass is force-disabled when NODE_ENV=production.
# NODE_ENV=development
# DEV_AUTH_ENABLED=1
# VITE_DEV_AUTH=1

# --- Single-origin serving (Render preview / local prod-style run) ---
# SERVE_CLIENT=1
# CLIENT_DIST=artifacts/milestones/dist/public

# --- Production hardening (see replit.md) ---
# CORS_ALLOWED_ORIGINS=https://your-frontend-origin
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=600

# --- Procore (demo mode needs no real credentials) ---
PROCORE_DEMO_MODE=1
